# SPDX-License-Identifier: GPL-2.0-or-later
# U-Boot 2025.01 proper config fragment for the QEMU ROCK 5B machine.
#
# Base defconfig: rock5b-rk3588_defconfig.
# Derived from qemu-machine-images branch upstream/rock-5b (commit
# eacd4aea1879382428bfd87836aec41a869b6459) recipe/configs/uboot.config,
# with the QEMU deltas for an MMC/FAT-capable U-Boot:
#   - CONFIG_MMC / CONFIG_CMD_MMC / MMC_DW_ROCKCHIP enabled (reference v1.3.0
#     image had MMC disabled),
#   - FAT filesystem + fatload/fatls, "source" (boot.scr) and "unzip"
#     (compressed Linux Image staging) commands,
#   - default environment boots boot.scr from the SD card through the
#     ProcessONE "mmc dev 1" controller,
#   - appended control DTS rock5b-qemu.dts (with sdmmc@fe2c0000, aliases
#     mmc1) and the Rockchip DDR ATAGS patch for QEMU memory-size discovery.
CONFIG_TEXT_BASE=0x00200000
CONFIG_DEFAULT_DEVICE_TREE="rock5b-qemu"
CONFIG_OF_LIST="rock5b-qemu"
CONFIG_SPL_OF_LIST="rock5b-qemu"
# CONFIG_OF_UPSTREAM is not set
CONFIG_ROCKCHIP_EXTERNAL_TPL=y
CONFIG_BOOTDELAY=2
CONFIG_ENV_IS_IN_SPI_FLASH=y
# CONFIG_ENV_IS_IN_MMC is not set
# CONFIG_ENV_IS_NOWHERE is not set
CONFIG_ENV_OFFSET=0x3f0000
CONFIG_ENV_SIZE=0x10000
CONFIG_ENV_SECT_SIZE=0x1000
CONFIG_SYS_SPI_U_BOOT_OFFS=0
CONFIG_SF_DEFAULT_BUS=0
CONFIG_SF_DEFAULT_MODE=0
CONFIG_SF_DEFAULT_SPEED=24000000
CONFIG_FIT=y
CONFIG_LZMA=y
CONFIG_SYS_BOOTM_LEN=0x8000000
CONFIG_HUSH_PARSER=y
CONFIG_CMD_SF=y
CONFIG_CMD_SAVEENV=y
CONFIG_SYSRESET_PSCI=y
# CONFIG_ROCKCHIP_SPI_IMAGE is not set
# CONFIG_BINMAN_FDT is not set
# CONFIG_DISPLAY_BOARDINFO_LATE is not set
# CONFIG_MISC_INIT_R is not set
# CONFIG_DM_RNG is not set
# CONFIG_ROCKCHIP_OTP is not set
# CONFIG_SCMI_FIRMWARE is not set
# CONFIG_CLK_SCMI is not set
# CONFIG_PCI is not set
# CONFIG_AHCI is not set
# CONFIG_USB is not set
# CONFIG_USB_GADGET is not set
# CONFIG_PHY_ROCKCHIP_USBDP is not set
# CONFIG_CMD_USB is not set
# CONFIG_CMD_PCI is not set
# CONFIG_CMD_TCPM is not set
# CONFIG_TYPEC_TCPM is not set
# CONFIG_NET is not set
# CONFIG_EFI_LOADER is not set

# --- host tools / image signing (self-contained macOS build) ---
# The macOS build host has no OpenSSL development headers in the default
# toolchain search path, and the QEMU boot media used here is not signed.
# Disabling host-tool libcrypto keeps the rebuild reproducible on this host;
# the target-side legacy-uImage boot path does not need FIT signing.
# CONFIG_FIT_SIGNATURE is not set
# CONFIG_SPL_FIT_SIGNATURE is not set
# CONFIG_FIT_CIPHER is not set
# CONFIG_TOOLS_LIBCRYPTO is not set
# CONFIG_TOOLS_KWBIMAGE is not set

# --- MMC / SD card + FAT payload support (QEMU dw_mmc model) ---
CONFIG_MMC=y
CONFIG_DM_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_CMD_MMC=y
CONFIG_BLK=y
CONFIG_CLK=y
CONFIG_FS_FAT=y
CONFIG_CMD_FAT=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_DOS_PARTITION=y
CONFIG_PARTITION_UUIDS=y
CONFIG_CMD_SOURCE=y
CONFIG_CMD_UNZIP=y
CONFIG_GZIP=y

# --- default environment: boot boot.scr from the SD card (mmc dev 1) ---
CONFIG_BOOTCOMMAND="mmc dev 1 && mmc rescan && fatload mmc 1:1 0x08000000 boot.scr && source 0x08000000"
