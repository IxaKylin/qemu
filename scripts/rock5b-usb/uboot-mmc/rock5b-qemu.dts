// SPDX-License-Identifier: GPL-2.0-or-later
/dts-v1/;

/*
 * U-Boot control device tree for the QEMU ROCK 5B machine.
 *
 * Derived from qemu-machine-images branch upstream/rock-5b
 * (commit eacd4aea1879382428bfd87836aec41a869b6459)
 * machine/aarch64/rock-5b/recipe/dts/rock5b-qemu.dts.
 *
 * QEMU-specific delta: a dw_mmc SD-card controller node at sdmmc@fe2c0000
 * (aliases mmc1, the controller selected by ProcessONE's "mmc dev 1" boot
 * script) and a fixed-clock source for its biu/ciu/phase clocks.  The
 * reference QEMU machine has no SCMI clock protocol, so the ciu clock is a
 * fixed clock; U-Boot only uses it for divider bookkeeping and the QEMU
 * dw_mmc model is register driven.
 */

/ {
    model = "Radxa ROCK 5B QEMU";
    compatible = "radxa,rock-5b", "rockchip,rk3588";
    #address-cells = <2>;
    #size-cells = <2>;

    aliases {
        serial2 = &uart2;
        spi0 = &sfc;
        mmc1 = &sdmmc;
    };

    chosen {
        stdout-path = &uart2;
    };

    xin24m: clock-24m {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <24000000>;
        bootph-all;
    };

    sdmmc_clk: sdmmc-clock {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <50000000>;
        bootph-all;
    };

    sys_grf: syscon@fd58c000 {
        compatible = "rockchip,rk3588-sys-grf", "syscon";
        reg = <0 0xfd58c000 0 0x1000>;
        bootph-all;
    };

    php_grf: syscon@fd5b0000 {
        compatible = "rockchip,rk3588-php-grf", "syscon";
        reg = <0 0xfd5b0000 0 0x1000>;
        bootph-all;
    };

    cru: clock-controller@fd7c0000 {
        compatible = "rockchip,rk3588-cru";
        reg = <0 0xfd7c0000 0 0x5c000>;
        rockchip,grf = <&php_grf>;
        #clock-cells = <1>;
        #reset-cells = <1>;
        bootph-all;
    };

    uart2: serial@feb50000 {
        compatible = "rockchip,rk3588-uart", "snps,dw-apb-uart";
        reg = <0 0xfeb50000 0 0x100>;
        clock-frequency = <24000000>;
        clocks = <&xin24m>, <&xin24m>;
        clock-names = "baudclk", "apb_pclk";
        reg-shift = <2>;
        reg-io-width = <4>;
        bootph-all;
    };

    sfc: spi@fe2b0000 {
        compatible = "rockchip,sfc";
        reg = <0 0xfe2b0000 0 0x4000>;
        clocks = <&cru 303>, <&cru 304>;
        clock-names = "clk_sfc", "hclk_sfc";
        #address-cells = <1>;
        #size-cells = <0>;

        flash@0 {
            compatible = "jedec,spi-nor";
            reg = <0>;
            spi-max-frequency = <24000000>;
            spi-tx-bus-width = <1>;
            spi-rx-bus-width = <1>;
        };
    };

    /*
     * RK3588 SD-card controller (dw_mmc).  The QEMU rock-5b machine models
     * the controller at 0xfe2c0000 (GIC SPI 203) and attaches
     * "-drive if=sd,index=2" as the card.  Mainline U-Boot's
     * rockchip_dw_mmc driver matches the rk3288 fallback compatible.
     */
    sdmmc: mmc@fe2c0000 {
        compatible = "rockchip,rk3588-dw-mshc", "rockchip,rk3288-dw-mshc";
        reg = <0x0 0xfe2c0000 0x0 0x4000>;
        clocks = <&sdmmc_clk>, <&sdmmc_clk>, <&sdmmc_clk>, <&sdmmc_clk>;
        clock-names = "biu", "ciu", "ciu-drive", "ciu-sample";
        fifo-depth = <0x100>;
        max-frequency = <50000000>;
        bus-width = <4>;
        status = "okay";
    };

    otp@fecc0000 {
        compatible = "rockchip,rk3588-otp";
        reg = <0 0xfecc0000 0 0x400>;
    };
};
